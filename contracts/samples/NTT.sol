    function mulZQ(
        uint[] memory a,
        uint[] memory b
    ) public view returns (uint[] memory) {
        return iNTT(mulNTT(nTT(a), nTT(b)));
    }

    function iNTT(uint[] memory p) public view returns (uint[] memory) {
        uint[] memory res = new uint[](p.length);
        if (p.length > 2) {
            // split p into p0 and p1
            uint[] memory p0 = new uint[](p.length / 2);
            uint[] memory p1 = new uint[](p.length / 2);
            (p0, p1) = splitNTT(p);
            // compute iNTT(p0) and iNTT(p1)
            p0 = iNTT(p0);
            p1 = iNTT(p1);
            for (uint i = 0; i < p0.length; i++) {
                res[i * 2] = p0[i];
                res[i * 2 + 1] = p1[i];
            }
        } else {
            // original was elif p.length == 2 but there's no need to check ?
            // p[0] = (i2 * (p[0] + p[1])) % q
            res[0] = mulmod(i2, addmod(p[0], p[1], q), q);
            // f[1] = (i2 * inv_mod_q[1479] * (p[0] - p[1])) % q
            uint negp1 = q - p[1];
            uint tmp = addmod(p[0], negp1, q);
            res[1] = mulmod(mulmod(i2, inv_mod_q[1479], q), tmp, q);
        }
        return res;
    }
    function splitNTT(
        uint[] memory p
    ) public view returns (uint[] memory, uint[] memory) {
        uint[] memory p0 = new uint[](p.length / 2);
        uint[] memory p1 = new uint[](p.length / 2);
        uint dizN = p.length;
        for (uint i = 0; i < dizN / 2; i++) {
            // p0[i] = (i2 * (p[2 * i] + p[2 * i + 1])) % q
            p0[i] = mulmod(i2, addmod(p[2 * i], p[2 * i + 1], q), q);
            // p1[i] = (i2 * (p[2 * i] - p[2 * i + 1]) * inv_mod_q[w[2 * i]]) % q
            uint neg2i1 = q - p[2 * i + 1];
            uint tmpi2m2i1 = addmod(p[2 * i], neg2i1, q);
            uint tmp = mulmod(i2, tmpi2m2i1, q);
            p1[i] = mulmod(tmp, inv_mod_q[w[dizN][2 * i]], q);
        }
        return (p0, p1);
    }

    function nTT(uint[] memory p) public view returns (uint[] memory) {
        uint[] memory res = new uint[](p.length);
        if (p.length > 2) {
            // split p into p0 and p1
            uint[] memory p0 = new uint[](p.length / 2);
            uint[] memory p1 = new uint[](p.length / 2);
            for (uint i = 0; i < p.length / 2; i++) {
                p0[i] = p[i * 2];
                p1[i] = p[i * 2 + 1];
            }
            // compute nTT(p0) and nTT(p1)
            p0 = nTT(p0);
            p1 = nTT(p1);
            res = mergeNTT(p0, p1);
        } else {
            // original was elif p.length == 2 but there's no need to check ?
            res[0] = addmod(p[0], mulmod(p[1], sqr1, q), q);
            uint negsq1p1 = q - mulmod(p[1], sqr1, q);
            res[1] = addmod(p[0], negsq1p1, q);
        }
        return res;
    }

    function mergeNTT(
        uint[] memory p0,
        uint[] memory p1
    ) public view returns (uint[] memory) {
        uint dizN = p0.length * 2;
        uint[] memory res = new uint[](dizN);
        for (uint i = 0; i < p0.length; i++) {
            // res[i *2] = p0[i] + w[i] * p1[i] % q
            res[i * 2] = addmod(p0[i], mulmod(w[dizN][2 * i], p1[i], q), q);
            // res[i * 2 + 1] = p0[i] - w[i] * p1[i] % q
            uint negwp0 = q - mulmod(w[dizN][2 * i], p1[i], q);
            res[i * 2 + 1] = addmod(p0[i], negwp0, q);
        }
        return res;
    }

    function mulNTT(
        uint[] memory a,
        uint[] memory b
    ) public view returns (uint[] memory) {
        assert(a.length == b.length);
        uint[] memory res = new uint[](a.length);
        for (uint i = 0; i < a.length; i++) {
            res[i] = mulmod(a[i], b[i], q);
        }
        return res;
    }

    function subZQ(
        uint[] memory a,
        uint[] memory b
    ) public view returns (uint[] memory) {
        assert(a.length == b.length);
        return addZQ(a, negZQ(b));
    }

    function negZQ(uint[] memory a) public view returns (uint[] memory) {
        // assume a < q for all a
        uint[] memory res = new uint[](a.length);
        for (uint i = 0; i < a.length; i++) {
            // assume a < q for all a
            res[i] = (q - a[i]) % q;
        }
        return res;
    }

    function addZQ(
        uint[] memory a,
        uint[] memory b
    ) public view returns (uint[] memory) {
        assert(a.length == b.length);
        uint[] memory res = new uint[](a.length);
        for (uint i = 0; i < a.length; i++) {
            res[i] = addmod(a[i], b[i], q);
        }
        return res;
    }
